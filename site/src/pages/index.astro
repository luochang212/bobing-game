---
import { existsSync, readFileSync } from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Roll from '../components/Roll.astro';
import { ArrowUpRight, Download } from 'lucide-astro';
import bowl from '../assets/porcelain-bowl.png';

const pdf = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}rules-paper.pdf`;
// 讲解页按仓库根的 current 指针渲染对应版本；文案随版本自含于 versions/<名>/site-data.json，
// 规则语义仍以该版本 rules-paper.tex 为准，这里只负责讲解与展示。
// 预渲染打包后 import.meta.url 不再指向源码位置，改从 cwd 向上找含 current 与 versions/ 的目录。
function findRepoRoot(start) {
  let dir = path.resolve(start);
  for (let i = 0; i < 6; i++) {
    if (existsSync(path.join(dir, 'current')) && existsSync(path.join(dir, 'versions'))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  throw new Error('找不到仓库根（应含 current 文件与 versions/ 目录）');
}
const repoRoot = findRepoRoot(process.cwd());
const current = readFileSync(path.join(repoRoot, 'current'), 'utf-8').trim();
const data = JSON.parse(readFileSync(path.join(repoRoot, 'versions', current, 'site-data.json'), 'utf-8'));
const prizes = data.prizes.items;
const ranks = data.champion.ranks;
---
<Layout title={data.meta.title} description={data.meta.description}>
  <header class="site-header shell">
    <a href="#" class="brand" aria-label="中秋博饼，回到顶部"><span class="brand-die" aria-hidden="true">四</span><span>中秋博饼</span></a>
    <a class="header-download" href={pdf} download>规则纸 PDF <Download aria-hidden="true" /></a>
  </header>

  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">{data.hero.title}</h1>
      <p class="hero-description">{data.hero.description}</p>
      <p class="edition">{data.hero.edition}</p>
    </div>
    <figure class="hero-art">
      <Image src={bowl} alt="花纹白瓷碗中的六颗骰子" width={400} widths={[160,400,800]} sizes="(max-width: 700px) 96px, 280px" format="webp" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <nav class="reading-nav" aria-label="规则目录">
    <div class="shell">
      <a href="#overview">看全局</a><a href="#start">怎么掷</a><a href="#prizes">查奖级</a><a href="#champion">比状元</a><a href="#ending">收尾</a><a href="#questions">小提醒</a>
    </div>
  </nav>

  <main id="main" class="shell reading-content">
    <section id="overview" class="overview-section" aria-labelledby="overview-title">
      <div class="section-heading"><h2 id="overview-title">{data.overview.title}</h2></div>
      <div class="game-intro prose">
        <Fragment set:html={data.overview.intro.join('\n')} />
      </div>
      <ol class="game-route" aria-label="一局的三个阶段">
        {data.overview.route.map((step, index) => <li><span>{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
      </ol>
      <p class="section-bridge">{data.overview.bridge}</p>
    </section>

    <section id="start" class="start-section" aria-labelledby="start-title">
      <div class="section-heading"><h2 id="start-title">{data.start.title}</h2></div>
      <div class="prose">
        <Fragment set:html={data.start.intro.join('\n')} />
      </div>
      <h3 class="subheading">{data.start.subheading}</h3>
      <ol class="steps">
        {data.start.steps.map((step, index) => <li><span class="step-number">{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
      </ol>
      <p class="throw-help"><Fragment set:html={data.start.throwHelp} /></p>
      <p class="section-bridge">{data.start.bridge}</p>
    </section>

    <section id="prizes" class="prizes-section" aria-labelledby="prizes-title">
      <div class="section-heading"><h2 id="prizes-title">{data.prizes.title}</h2></div>
      <div class="prose section-lead"><Fragment set:html={data.prizes.lead} /></div>
      <p class="dice-guide"><Fragment set:html={data.prizes.diceGuide} /></p>
      <div class="prize-list">
        {prizes.map(prize => <article class="prize-card" id={`prize-${prize.id}`} aria-labelledby={`title-${prize.id}`}>
          <div class="prize-card-heading"><h3 id={`title-${prize.id}`}>{prize.name}</h3><span>{prize.id === 'zhuangyuan' ? '状元奖' : '普通奖'}，{prize.count} 份</span></div>
          <p class="prize-condition">{prize.condition}</p>
          <div class="prize-example"><Roll faces={prize.faces}/><span>示例</span></div>
          {prize.id === 'zhuangyuan' && <a class="prize-rank-link" href="#champion">博到状元后，查看六个等级怎么比</a>}
        </article>)}
      </div>
      <div class="worked-example"><h3>{data.prizes.workedExample.title}</h3><Roll faces={data.prizes.workedExample.faces} /><div class="prose"><Fragment set:html={data.prizes.workedExample.paragraphs.join('\n')} /></div></div>
      <p class="rule-callout">{data.prizes.callout}</p>
      <p class="section-bridge">{data.prizes.bridge}</p>
    </section>

    <section id="champion" class="champion-section" aria-labelledby="champion-title">
      <div class="champion-heading"><h2 id="champion-title">{data.champion.title}</h2><div class="prose champion-description"><Fragment set:html={data.champion.description.join('\n')} /></div></div>
      <div class="rank-list"><p class="rank-list-caption">{data.champion.caption}</p>{ranks.map((rank,index) => <div class:list={['rank-row',{'rank-first':index===0}]}><div class="rank-name"><h3>{rank.name}</h3><p>{rank.rule}</p></div><div class="rank-example"><Roll faces={rank.faces}/><p>{rank.compare}</p></div></div>)}</div>
      <div class="prose comparison-example"><Fragment set:html={data.champion.comparisonExample.join('\n')} /></div>
      <p class="section-bridge">{data.champion.bridge}</p>
    </section>

    <section id="ending" class="ending-section" aria-labelledby="ending-title">
      <div class="section-heading"><h2 id="ending-title">{data.ending.title}</h2></div>
      <div class="prose section-lead"><Fragment set:html={data.ending.lead} /></div>
      <ol class="ending-steps">
        {data.ending.steps.map((step, index) => <li><span>{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
      {data.ending.extraCallout && <p class="rule-callout">{data.ending.extraCallout}</p>}
    </section>

    <section id="questions" class="questions-section" aria-labelledby="questions-title">
      <div class="section-heading"><h2 id="questions-title">{data.questions.title}</h2></div>
      <div class="exception-list">
        {data.questions.exceptions.map(item => <article><h3>{item.title}</h3><p><Fragment set:html={item.text} /></p></article>)}
      </div>
      <div class="faq-list">
        {data.questions.faq.map(item => <details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}
      </div>
    </section>

    <section class="download-section" aria-labelledby="download-title">
      <div class="paper-icon" aria-hidden="true"><span>中秋<br />博饼</span><i></i><i></i><i></i><small>A4</small></div>
      <div class="download-copy"><h2 id="download-title">需要纸质版？</h2><p>每桌一张规则纸，手机同步查阅；需要补印可下载 PDF。</p><p class="print-settings">打印设置：纵向 · 实际大小 100% · 黑白</p></div>
      <a class="button button-dark" href={pdf} download>下载规则 PDF <Download aria-hidden="true" /></a>
    </section>
  </main>
  <footer class="site-footer shell"><a class="brand" href="#"><span class="brand-die" aria-hidden="true">四</span><span>中秋博饼</span></a><p>祝大家中秋快乐，博个好彩头。</p><a href="https://github.com/luochang212/bobing-game">项目源码<ArrowUpRight aria-hidden="true" /></a></footer>
</Layout>
