---
import { Download } from 'lucide-astro';
import BrandMark from './BrandMark.astro';

interface Props {
  pdf: string;
  label: string;
}

const { pdf, label } = Astro.props;
---
<header class="site-header shell">
  <a href="#" class="brand" aria-label="中秋博饼，回到顶部"><BrandMark /><span>中秋博饼</span></a>
  <a class="header-download" href={pdf} download>{label} <Download aria-hidden="true" /></a>
</header>
